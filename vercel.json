{
  "version": 2,
  "builds": [
    {
      "src": "api-server/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/movies",
      "dest": "/api-server/movies.js"
    },
    {
      "src": "/api/movies/(.*)",
      "dest": "/api-server/movies.js"
    },
    {
      "src": "/api/genres",
      "dest": "/api-server/genres.js"
    },
    {
      "src": "/api/genres/(.*)",
      "dest": "/api-server/genres.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
