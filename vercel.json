{
  "rewrites": [
    {
      "source": "/api/movies/:path*",
      "destination": "/api-server/movies.js"
    },
    {
      "source": "/api/movies",
      "destination": "/api-server/movies.js"
    },
    {
      "source": "/api/genres/:path*",
      "destination": "/api-server/genres.js"
    },
    {
      "source": "/api/genres",
      "destination": "/api-server/genres.js"
    },
    {
      "source": "/api/boxoffice/:path*",
      "destination": "/api-server/boxoffice.js"
    },
    {
      "source": "/api/boxoffice",
      "destination": "/api-server/boxoffice.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
